exports[`outside a scope the portability dialogs render exactly as on main signing summary, signed with certificate 1`] = `"<div><div class="space-y-1"><div class="text-emerald-300/90" data-testid="pld-signing-note">Signed.</div><div class="text-slate-300 space-y-0.5"><div>Certificate of Export <span class="font-mono">PLD-1</span> <a href="https://x" target="_blank" rel="noreferrer" class="text-cyan-300 underline" data-testid="pld-certificate-link">Download certificate</a></div><div data-testid="pld-verification-code">Verification code <span class="font-mono">v</span>. Keep this code with the certificate; anyone can confirm the export at /legal/verify-export with the number and the code.</div></div></div></div>"`;

exports[`outside a scope the portability dialogs render exactly as on main signing summary, unsigned 1`] = `"<div><div class="space-y-1"><div class="text-slate-400" data-testid="pld-signing-note">Not signed.</div></div></div>"`;
