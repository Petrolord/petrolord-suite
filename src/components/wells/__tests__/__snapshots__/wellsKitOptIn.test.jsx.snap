 44px;" title="Stop value" data-testid="petro-layout-ramp-value-2-2" inputmode="decimal" value="150"><input type="color" class="w-6 h-5 rounded border border-slate-700 bg-transparent" data-testid="petro-layout-ramp-color-2-2" value="#5c3a1e"><button type="button" class="text-slate-500 hover:text-red-400" title="Remove stop">×</button></span><button type="button" class="text-slate-400 hover:text-slate-200" title="Add a stop" data-testid="petro-layout-ramp-add-2">+ stop</button><label class="flex items-center gap-0.5 text-slate-500" title="Opacity"><input type="range" min="0" max="1" step="0.05" class="w-14" data-testid="petro-layout-fill-opacity-2" value="0.85">85%</label><button type="button" class="text-slate-500 hover:text-red-400" title="Remove fill"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></div><button type="button" data-testid="petro-layout-add-fill" class="flex items-center gap-1 px-1.5 py-0.5 rounded border border-slate-700 text-slate-400 hover:bg-slate-800 disabled:opacity-40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Fill</button></div></div><div class="rounded border border-slate-800" data-testid="petro-layout-track-Lithology"><div class="flex items-center gap-1 px-1.5 py-1"><button type="button" class="text-slate-400" data-testid="petro-layout-expand-Lithology"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m9 18 6-6-6-6"></path></svg></button><span class="truncate text-slate-300">Lithology</span><span class="text-slate-600 text-[10px]">strip</span><div class="ml-auto flex items-center gap-0.5"><button type="button" title="Move up" class="text-slate-500 hover:text-slate-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button><button type="button" title="Move down" class="text-slate-500 hover:text-slate-200" data-testid="petro-layout-down-Lithology"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg></button><button type="button" title="Remove track" class="text-slate-500 hover:text-red-400" data-testid="petro-layout-remove-Lithology"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></div></div></div><div class="flex gap-1"><button type="button" data-testid="petro-layout-add-track" class="flex-1 flex items-center justify-center gap-1 px-2 py-1 rounded border border-slate-700 text-slate-300 hover:bg-slate-800"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stro