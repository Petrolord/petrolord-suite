exports[`outside a scope the wells kit renders exactly as on main intervals editor, biozones 1`] = `"<div class="space-y-2 text-xs" data-testid="wdm-intervals-editor"><div class="flex items-center gap-2 flex-wrap"><label class="flex items-center gap-1 text-slate-400">Kind<select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-kind"><option value="lithology">Lithology</option><option value="core_description">Core description</option><option value="facies">Facies</option><option value="electrofacies">Electrofacies</option><option value="environment">Depositional environment</option><option value="motif">Log motif</option><option value="systems_tract">Systems tract</option><option value="biozone_interval">Biozone</option></select></label><span class="text-slate-500">1 on KETA-1</span><div class="ml-auto flex items-center gap-1"><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 " data-testid="wdm-intervals-paste-toggle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 2H9a1 1 0 0 0-1 1v2c0 .6.4 1 1 1h6c.6 0 1-.4 1-1V3c0-.6-.4-1-1-1Z"></path><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2M16 4h2a2 2 0 0 1 2 2v2M11 14h10"></path><path d="m17 10 4 4-4 4"></path></svg> Replace from paste</button><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40" data-testid="wdm-intervals-add"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add</button><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 " disabled="" data-testid="wdm-intervals-save"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save biozone interval</button></div></div><div class="overflow-x-auto"><table class="text-xs min-w-[860px]"><thead><tr><th class="text-left font-medium text-slate-500 pr-3 pb-1"></th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Top (m)</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Base (m)</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Biozone</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Label</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Scheme</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Age top (Ma)</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Age base (Ma)</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Description</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Source</th><th class="text-left font-medium text-slate-500 pr-3 pb-1"></th></tr></thead><tbody><tr data-testid="wdm-intervals-row-0"><td class="pr-2 py-0.5"><span class="inline-block w-3 h-3 rounded-sm" style="background: rgb(203, 213, 225);"></span></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-top-0" value="1400"></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-base-0" value="1450"></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 150px;" placeholder="Zone name" data-testid="wdm-intervals-code-0" value="NN12"></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 120px;" data-testid="wdm-intervals-label-0" value=""></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 110px;" placeholder="e.g. NN, planktonic forams" data-testid="wdm-intervals-scheme-0" value="NN"></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-agetop-0" value=""></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-agebase-0" value=""></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 220px;" data-testid="wdm-intervals-desc-0" value=""></td><td class="pr-3 py-0.5"><select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-source-0"><option value="core">core</option><option value="cuttings">cuttings</option><option value="log">log</option><option value="interpretation">interpretation</option><option value="import">import</option></select></td><td class="py-0.5"><button type="button" class="text-slate-500 hover:text-red-400" title="Remove" data-testid="wdm-intervals-del-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></td></tr></tbody></table></div><div class="text-slate-500" data-testid="wdm-intervals-thickness">Thickness: NN12 50.0 m</div></div>"`;

exports[`outside a scope the wells kit renders exactly as on main intervals editor, empty kind 1`] = `"<div class="space-y-2 text-xs" data-testid="wdm-intervals-editor"><div class="flex items-center gap-2 flex-wrap"><label class="flex items-center gap-1 text-slate-400">Kind<select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-kind"><option value="lithology">Lithology</option><option value="core_description">Core description</option><option value="facies">Facies</option><option value="electrofacies">Electrofacies</option><option value="environment">Depositional environment</option><option value="motif">Log motif</option><option value="systems_tract">Systems tract</option><option value="biozone_interval">Biozone</option></select></label><span class="text-slate-500">0 on KETA-1 (read-only)</span><div class="ml-auto flex items-center gap-1"><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 " disabled="" data-testid="wdm-intervals-paste-toggle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 2H9a1 1 0 0 0-1 1v2c0 .6.4 1 1 1h6c.6 0 1-.4 1-1V3c0-.6-.4-1-1-1Z"></path><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2M16 4h2a2 2 0 0 1 2 2v2M11 14h10"></path><path d="m17 10 4 4-4 4"></path></svg> Replace from paste</button><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40" disabled="" data-testid="wdm-intervals-add"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add</button><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 " disabled="" data-testid="wdm-intervals-save"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save facies</button></div></div><div class="text-slate-500" data-testid="wdm-intervals-empty">No facies intervals on this well yet. Add rows, paste a table, or import a LAS 3.0 file with a core or lithology block in Well Data Manager.</div></div>"`;

exports[`outside a scope the wells kit renders exactly as on main intervals editor, lithology with problems 1`] = `"<div class="space-y-2 text-xs" data-testid="wdm-intervals-editor"><div class="flex items-center gap-2 flex-wrap"><label class="flex items-center gap-1 text-slate-400">Kind<select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-kind"><option value="lithology">Lithology</option><option value="core_description">Core description</option><option value="facies">Facies</option><option value="electrofacies">Electrofacies</option><option value="environment">Depositional environment</option><option value="motif">Log motif</option><option value="systems_tract">Systems tract</option><option value="biozone_interval">Biozone</option></select></label><span class="text-slate-500">2 on KETA-1</span><div class="ml-auto flex items-center gap-1"><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 " data-testid="wdm-intervals-paste-toggle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 2H9a1 1 0 0 0-1 1v2c0 .6.4 1 1 1h6c.6 0 1-.4 1-1V3c0-.6-.4-1-1-1Z"></path><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2M16 4h2a2 2 0 0 1 2 2v2M11 14h10"></path><path d="m17 10 4 4-4 4"></path></svg> Replace from paste</button><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40" data-testid="wdm-intervals-add"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add</button><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 border-cyan-500/60 text-cyan-300" data-testid="wdm-intervals-save"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save lithology</button></div></div><ul class="text-red-300 space-y-0.5" data-testid="wdm-intervals-problems"><li>sandstone: the base (1450 m) is not below the top (1460 m).</li><li>lithology: "sandstone" (1460 to 1450 m) overlaps "shale" (1400 to 1470 m).</li></ul><div class="overflow-x-auto"><table class="text-xs min-w-[860px]"><thead><tr><th class="text-left font-medium text-slate-500 pr-3 pb-1"></th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Top (m)</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Base (m)</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Lithology</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Label</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Grain size</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Description</th><th class="text-left font-medium text-slate-500 pr-3 pb-1">Source</th><th class="text-left font-medium text-slate-500 pr-3 pb-1"></th></tr></thead><tbody><tr data-testid="wdm-intervals-row-0"><td class="pr-2 py-0.5"><span class="inline-block w-3 h-3 rounded-sm" style="background: rgb(143, 160, 138);"></span></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-top-0" value="1400"></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-base-0" value="1470"></td><td class="pr-3 py-0.5"><select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 150px;" data-testid="wdm-intervals-code-0"><option value="sandstone">Sandstone</option><option value="siltstone">Siltstone</option><option value="shale">Shale</option><option value="marl">Marl</option><option value="conglomerate">Conglomerate</option><option value="limestone">Limestone</option><option value="chalk">Chalk</option><option value="dolomite">Dolomite</option><option value="anhydrite">Anhydrite</option><option value="gypsum">Gypsum</option><option value="halite">Halite (salt)</option><option value="coal">Coal</option><option value="chert">Chert</option><option value="volcanic">Volcanic</option><option value="basement">Basement</option><option value="unknown">Unknown</option></select></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 120px;" data-testid="wdm-intervals-label-0" value=""></td><td class="pr-3 py-0.5"><select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-grain-0"><option value="">none</option><option value="clay">Clay</option><option value="silt">Silt</option><option value="vf_sand">Very fine sand</option><option value="f_sand">Fine sand</option><option value="m_sand">Medium sand</option><option value="c_sand">Coarse sand</option><option value="vc_sand">Very coarse sand</option><option value="granule">Granule</option><option value="pebble">Pebble</option><option value="cobble">Cobble</option><option value="boulder">Boulder</option></select></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 220px;" data-testid="wdm-intervals-desc-0" value=""></td><td class="pr-3 py-0.5"><select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-source-0"><option value="core">core</option><option value="cuttings">cuttings</option><option value="log">log</option><option value="interpretation">interpretation</option><option value="import">import</option></select></td><td class="py-0.5"><button type="button" class="text-slate-500 hover:text-red-400" title="Remove" data-testid="wdm-intervals-del-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></td></tr><tr data-testid="wdm-intervals-row-1"><td class="pr-2 py-0.5"><span class="inline-block w-3 h-3 rounded-sm" style="background: rgb(244, 208, 63);"></span></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-top-1" value="1460"></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-intervals-base-1" value="1450"></td><td class="pr-3 py-0.5"><select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 150px;" data-testid="wdm-intervals-code-1"><option value="sandstone">Sandstone</option><option value="siltstone">Siltstone</option><option value="shale">Shale</option><option value="marl">Marl</option><option value="conglomerate">Conglomerate</option><option value="limestone">Limestone</option><option value="chalk">Chalk</option><option value="dolomite">Dolomite</option><option value="anhydrite">Anhydrite</option><option value="gypsum">Gypsum</option><option value="halite">Halite (salt)</option><option value="coal">Coal</option><option value="chert">Chert</option><option value="volcanic">Volcanic</option><option value="basement">Basement</option><option value="unknown">Unknown</option></select></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 120px;" data-testid="wdm-intervals-label-1" value=""></td><td class="pr-3 py-0.5"><select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-grain-1"><option value="">none</option><option value="clay">Clay</option><option value="silt">Silt</option><option value="vf_sand">Very fine sand</option><option value="f_sand">Fine sand</option><option value="m_sand">Medium sand</option><option value="c_sand">Coarse sand</option><option value="vc_sand">Very coarse sand</option><option value="granule">Granule</option><option value="pebble">Pebble</option><option value="cobble">Cobble</option><option value="boulder">Boulder</option></select></td><td class="pr-3 py-0.5"><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 220px;" data-testid="wdm-intervals-desc-1" value=""></td><td class="pr-3 py-0.5"><select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-source-1"><option value="core">core</option><option value="cuttings">cuttings</option><option value="log">log</option><option value="interpretation">interpretation</option><option value="import">import</option></select></td><td class="py-0.5"><button type="button" class="text-slate-500 hover:text-red-400" title="Remove" data-testid="wdm-intervals-del-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></td></tr></tbody></table></div><div class="text-slate-500" data-testid="wdm-intervals-thickness">Thickness: Shale 70.0 m · Sandstone 0.0 m</div></div>"`;

exports[`outside a scope the wells kit renders exactly as on main intervals editor, paste mode 1`] = `"<div class="space-y-2 text-xs" data-testid="wdm-intervals-editor"><div class="flex items-center gap-2 flex-wrap"><label class="flex items-center gap-1 text-slate-400">Kind<select class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" data-testid="wdm-intervals-kind"><option value="lithology">Lithology</option><option value="core_description">Core description</option><option value="facies">Facies</option><option value="electrofacies">Electrofacies</option><option value="environment">Depositional environment</option><option value="motif">Log motif</option><option value="systems_tract">Systems tract</option><option value="biozone_interval">Biozone</option></select></label><span class="text-slate-500">2 on KETA-1</span><div class="ml-auto flex items-center gap-1"><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 border-cyan-500/60 text-cyan-300" data-testid="wdm-intervals-paste-toggle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 2H9a1 1 0 0 0-1 1v2c0 .6.4 1 1 1h6c.6 0 1-.4 1-1V3c0-.6-.4-1-1-1Z"></path><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2M16 4h2a2 2 0 0 1 2 2v2M11 14h10"></path><path d="m17 10 4 4-4 4"></path></svg> Back to table</button><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40 " disabled="" data-testid="wdm-intervals-save"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save lithology</button></div></div><div class="space-y-1"><div class="space-y-2" data-testid="wdm-intervals-paste-paste"><label class="text-xs text-slate-400 flex items-center gap-1">MD in<select class="rounded-md bg-slate-950 border border-slate-700 text-slate-200 px-1.5 py-1 text-xs" data-testid="wdm-intervals-paste-mdunit"><option value="m">metres</option><option value="ft">feet</option></select></label><textarea class="rounded-md bg-slate-950 border border-slate-700 text-slate-200 px-1.5 py-1 text-xs w-full h-24 font-mono" placeholder="Paste checkshots as exported (depth, time); the selectors above say how to read them" data-testid="wdm-intervals-paste-paste-text"></textarea></div><p class="text-slate-500">Replaces every lithology interval on this well. Lithology abbreviations (SST, SH, LS, DOL ...) resolve to the vocabulary; unknown ones are kept as typed.</p></div></div>"`;

exports[`outside a scope the wells kit renders exactly as on main layout panel, built-in template 1`] = `"<div class="p-2 space-y-1.5 text-xs border-t border-slate-800/60" data-testid="petro-layout"><div class="text-[10px] uppercase tracking-wider text-slate-500">Track layout</div><div class="flex items-center gap-1"><select class="rounded bg-slate-950 border border-slate-700 text-slate-200 px-1.5 py-0.5 text-xs w-full" data-testid="petro-layout-template"><option value="std-triple-combo">Standard triple combo (built-in)</option><option value="quicklook">Raw quicklook (built-in)</option><option value="lithology-quicklook">Lithology quicklook (built-in)</option></select></div><div class="flex gap-1"><button type="button" data-testid="petro-layout-saveas" class="flex-1 px-1.5 py-0.5 rounded border border-cyan-700/60 text-cyan-300 hover:bg-cyan-500/10">Save as…</button><button type="button" data-testid="petro-layout-rename" disabled="" title="Built-in templates fork when edited" class="flex-1 px-1.5 py-0.5 rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40">Rename</button><button type="button" data-testid="petro-layout-delete" disabled="" class="flex-1 px-1.5 py-0.5 rounded border border-red-900/60 text-red-300 hover:bg-red-500/10 disabled:opacity-40">Delete</button></div><p class="text-[10px] text-slate-500">Built-in template. Any edit forks it into your own copy.</p><div class="rounded border border-slate-800" data-testid="petro-layout-track-GR (API)"><div class="flex items-center gap-1 px-1.5 py-1"><button type="button" class="text-slate-400" data-testid="petro-layout-expand-GR (API)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m9 18 6-6-6-6"></path></svg></button><span class="truncate text-slate-300">GR (API)</span><span class="text-slate-600 text-[10px]">1 curve</span><di