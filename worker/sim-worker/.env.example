# Copy to .env (root-owned, chmod 0600 — the service-role key bypasses RLS).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
WORKER_ID=vps-sim-worker-1
LOG_LEVEL=INFO
# Optional cap overrides (defaults in simworker/config.py):
# WALL_CLOCK_S=1800
# FLOW_THREADS=2
# MAX_TOTAL_CELLS=200000
