exports[`outside a scope the wells kit renders exactly as on main top name popover with the name error 1`] = `"<div class="relative"><div class="absolute z-20 rounded border border-slate-300 bg-white shadow-lg p-2 text-xs w-56" style="left: 10px; top: 20px;" data-testid="petro-top-popover"><div class="text-slate-600 mb-1">New top</div><input list="petro-top-names" class="w-full rounded border border-slate-300 px-1.5 py-1 text-slate-900" placeholder="Top name" data-testid="petro-top-name" value=""><datalist id="petro-top-names"><option value="Top A"></option><option value="Top B"></option></datalist><div class="text-red-600 mt-1" data-testid="petro-top-name-error">The name is required.</div><div class="flex gap-1 mt-1.5 justify-end"><button type="button" class="px-2 py-0.5 rounded border border-slate-300 text-slate-700" data-testid="petro-top-cancel">Cancel</button><button type="button" class="px-2 py-0.5 rounded bg-cyan-600 text-white" data-testid="petro-top-confirm">OK</button></div></div></div>"`;
