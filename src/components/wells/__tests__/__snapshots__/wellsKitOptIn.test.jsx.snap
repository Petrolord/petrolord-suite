g/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button><button type="button" title="Move down" class="text-slate-500 hover:text-slate-200" data-testid="petro-layout-down-Lithology"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg></button><button type="button" title="Remove track" class="text-slate-500 hover:text-red-400" data-testid="petro-layout-remove-Lithology"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></div></div><div class="px-1.5 pb-1.5 space-y-1 border-t border-slate-800/60 pt-1"><div class="grid grid-cols-2 gap-1"><label class="flex items-center gap-1"><span class="text-slate-500 w-9">Title</span><input class="rounded bg-slate-950 border border-slate-700 text-slate-200 px-1 py-0.5 text-[11px]" style="width: 100%;" data-testid="petro-layout-track-title" value="Lithology"></label><label class="flex items-center gap-1"><span class="text-slate-500 w-9">Width</span><input class="rounded bg-slate-950 border border-slate-700 text-slate-200 px-1 py-0.5 text-[11px]" style="width: 100%;" data-testid="petro-layout-track-width" inputmode="decimal" value="0.45"></label><label class="flex items-center gap-1 col-span-2"><span class="text-slate-500 w-9">Source</span><select class="rounded bg-slate-