exports[`outside a scope the portability dialogs render exactly as on main export dialog, lists loaded 1`] = `"<span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none;" data-aria-hidden="true" aria-hidden="true"></span><div data-aria-hidden="true" aria-hidden="true"></div><div data-state="open" class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0" style="pointer-events: auto;" data-aria-hidden="true" aria-hidden="true"></div><div role="dialog" id="radix-ID" aria-describedby="radix-ID" aria-labelledby="radix-ID" data-state="open" class="fixed left-[50%] top-[50%] z-50 grid w-full translate-x-[-50%] translate-y-[-50%] gap-4 border p-6 shadow-lg duration-200 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%] sm:rounded-lg max-w-lg bg-slate-900 border-slate-700 text-slate-200" data-testid="pld-export-dialog" tabindex="-1" style="pointer-events: auto;"><div class="flex flex-col space-y-1.5 text-center sm:text-left"><h2 id="radix-ID" class="text-lg font-semibold leading-none tracking-tight text-white flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-cyan-400"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg> Export project package</h2><p id="radix-ID" class="text-sm text-slate-400">A portable .pld file with the selected items, their data, and open-format sidecars where a format exists. Import it into any Petrolord account for an independent copy.</p></div><div class="space-y-2"><label class="block text-xs text-slate-400">Package name<input data-testid="pld-name" class="mt-1 w-full rounded bg-slate-950 border border-slate-700 px-2 py-1 text-sm text-slate-200" placeholder="For example: KETA field handover" value="KETA TYPE-1"></label><div class="relative"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 absolute left-1.5 top-2 text-slate-500"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input data-testid="pld-search" class="w-full rounded bg-slate-950 border border-slate-700 pl-6 pr-2 py-1 text-xs text-slate-200" placeholder="Filter by name" value=""></div><div class="space-y-1.5"><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center "><span>Wells <span class="text-slate-600">(1 of 2)</span></span></div><div class="max-h-36 overflow-y-auto"><label class="flex items-center gap-2 px-2 py-1 text-xs text-slate-200 hover:bg-slate-800 cursor-pointer"><input type="checkbox" data-testid="pld-well-w1" class="accent-cyan-500" checked=""><span class="truncate">KETA TYPE-1</span></label><label class="flex items-center gap-2 px-2 py-1 text-xs text-slate-200 hover:bg-slate-800 cursor-pointer"><input type="checkbox" data-testid="pld-well-w2" class="accent-cyan-500"><span class="truncate">AKOMA-2</span><span class="ml-auto text-[10px] text-slate-500">shared</span></label></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center "><span>Surfaces <span class="text-slate-600">(0 of 1)</span></span></div><div class="max-h-36 overflow-y-auto"><label class="flex items-center gap-2 px-2 py-1 text-xs text-slate-200 hover:bg-slate-800 cursor-pointer"><input type="checkbox" data-testid="pld-surface-s1" class="accent-cyan-500"><span class="truncate">Top Sand A depth</span></label></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center "><span>Culture <span class="text-slate-600">(0 of 0)</span></span></div><div class="max-h-36 overflow-y-auto"><div class="px-2 py-2 text-xs text-slate-500">No culture sets in your registry.</div></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center cursor-pointer select-none" data-testid="pld-section-seismic"><span>Seismic <span class="text-slate-600">(0 of 0)</span></span><span class="ml-auto text-slate-600">hide</span></div><div class="max-h-36 overflow-y-auto"><div class="px-2 py-2 text-xs text-slate-500">No seismic projects, volumes or lines.</div></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center cursor-pointer select-none" data-testid="pld-section-wp_site"><span>Well planning sites <span class="text-slate-600">(0 of 0)</span></span><span class="ml-auto text-slate-600">hide</span></div><div class="max-h-36 overflow-y-auto"><div class="px-2 py-2 text-xs text-slate-500">No well planning sites.</div></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center cursor-pointer select-none" data-testid="pld-section-fields"><span>Production fields <span class="text-slate-600">(0 of 0)</span></span><span class="ml-auto text-slate-600">hide</span></div><div class="max-h-36 overflow-y-auto"><div class="px-2 py-2 text-xs text-slate-500">No production fields.</div></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center cursor-pointer select-none" data-testid="pld-section-cases"><span>Economics cases <span class="text-slate-600">(0 of 0)</span></span><span class="ml-auto text-slate-600">hide</span></div><div class="max-h-36 overflow-y-auto"><div class="px-2 py-2 text-xs text-slate-500">No economics cases or assumption sets.</div></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center cursor-pointer select-none" data-testid="pld-section-sim"><span>Simulation cases <span class="text-slate-600">(0 of 0)</span></span><span class="ml-auto text-slate-600">hide</span></div><div class="max-h-36 overflow-y-auto"><div class="px-2 py-2 text-xs text-slate-500">No simulation cases.</div></div></div><div class="rounded border border-slate-700 bg-slate-950/40"><div class="px-2 py-1 text-[11px] uppercase tracking-wider text-slate-500 border-b border-slate-800 flex items-center cursor-pointer select-none" data-testid="pld-section-saved"><span>Saved projects <span class="text-slate-600">(0 of 1)</span></span><span class="ml-auto text-slate-600">hide</span></div><div class="max-h-36 overflow-y-auto"><label class="flex items-center gap-2 px-2 py-1 text-xs text-slate-200 hover:bg-slate-800 cursor-pointer"><input type="checkbox" data-testid="pld-saved-saved_choke_projects-p1" class="accent-cyan-500"><span class="truncate">Choke KETA-1</span><span class="ml-auto text-[10px] text-slate-500 truncate max-w-[40%]">choke</span></label></div></div></div><label class="flex items-center gap-2 text-xs text-slate-300"><input type="checkbox" data-testid="pld-include-interp" class="accent-cyan-500" checked="">Include my interpretations that refer only to the selected wells</label><label class="flex items-center gap-2 text-xs text-slate-300"><input type="checkbox" data-testid="pld-include-sidecars" class="accent-cyan-500" checked="">Include open-format sidecars (LAS, ZMAP, CSV)</label></div><div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2"><button class="inline-flex items-center justify-center text-sm font-medium ring-offset-slate-900 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border bg-transparent hover:bg-slate-800 hover:text-white h-9 rounded-md px-3 border-slate-700 text-slate-300">Close</button><button class="inline-flex items-center justify-center text-sm font-medium ring-offset-slate-900 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-9 rounded-md px-3 bg-cyan-600 hover:bg-cyan-500 text-white" data-testid="pld-export-run"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 mr-1"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>Export package</button></div><button type="button" class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-slate-900 transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 disabled:pointer-events-none data-[state=open]:bg-slate-800 data-[state=open]:text-slate-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-slate-300"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Close</span></button></div><span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none;" data-aria-hidden="true" aria-hidden="true"></span>"`;

exports[`outside a scope the portability dialogs render exactly as on main import dialog, done 1`] = `"<span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none;" data-aria-hidden="true" aria-hidden="true"></span><div data-aria-hidden="true" aria-hidden="true"></div><div data-state="open" class="fixed inset-0 z-50 bg-black/80 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0" style="pointer-events: auto;" data-aria-hidden="true" aria-hidden="true"></div><div role="dialog" id="radix-ID" aria-describedby="radix-ID" aria-labelledby="radix-ID" data-state="open" class="fixed left-[50%] top-[50%] z-50 grid w-full translate-x-[-50%] translate-y-[-50%] gap-4 border p-6 shadow-lg duration-200 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%] sm:rounded-lg max-w-lg bg-slate-900 border-slate-700 text-slate-200" data-testid="pld-import-dialog" tabindex="-1" style="pointer-events: auto;"><div class="flex flex-col space-y-1.5 text-center sm:text-left"><h2 id="radix-ID" class="text-lg font-semibold leading-none tracking-tight text-white flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-cyan-400"><path d="M20.91 8.84 8.56 2.23a1.93 1.93 0 0 0-1.81 0L3.1 4.13a2.12 2.12 0 0 0-.05 3.69l12.22 6.93a2 2 0 0 0 1.94 0L21 12.51a2.12 2.12 0 0 0-.09-3.67Z"></path><path d="m3.09 8.84 12.35-6.61a1.93 1.93 0 0 1 1.81 0l3.65 1.9a2.12 2.12 0 0 1 .1 3.69L8.73 14.75a2 2 0 0 1-1.94 0L3 12.51a2.12 2.12 0 0 1 .09-3.67Z"></path><line x1="12" x2="12" y1="22" y2="13"></line><path d="M20 13.5v3.37a2.06 2.06 0 0 1-1.11 1.83l-6 3.08a1.93 1.93 0 0 1-1.78 0l-6-3.08A2.06 2.06 0 0 1 4 16.87V13.5"></path></svg> Import project package</h2><p id="radix-ID" class="text-sm text-slate-400">Open a .pld file and get an independent copy of its wells, surfaces and interpretations under your account. Nothing you already have is changed.</p></div><div class="space-y-2"><div class="rounded border border-slate-700 bg-slate-950/40 px-2 py-1.5 text-xs space-y-1" data-testid="pld-import-summary"><div class="text-slate-200">Imported 10 rows and 8 binary files, 2 already present from an earlier run.</div><ul class="list-disc pl-4 text-amber-300/90"><li>w</li></ul><ul class="list-disc pl-4 text-slate-400"><li>n</li></ul></div><div class="border-t border-slate-800 pt-1.5"><button type="button" class="flex items-center gap-1 text-xs text-slate-400 hover:text-slate-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m9 18 6-6-6-6"></path></svg> Import history</button></div></div><div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2"><button class="inline-flex items-center justify-center text-sm font-medium ring-offset-slate-900 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 h-9 rounded-md px-3 bg-cyan-600 hover:bg-cyan-500 text-white">Done</button></div><button type="button" class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-slate-900 transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 disabled:pointer-events-none data-[state=open]:bg-slate-800 data-[state=open]:text-slate-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-slate-300"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Close</span></button></div><span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none;" data-aria-hidden="true" aria-hidden="true"></span>"`;

