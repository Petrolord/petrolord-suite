BEGIN
CREATE TABLE
DO
 n  |                      probe                       |       result       |                         detail                         
----+--------------------------------------------------+--------------------+--------------------------------------------------------
  1 | normal signup creates own org as owner           | PASS               | 1
  2 | signup with organization_id and no token refused | PASS               | refused
  3 | stranger add_user_to_organization denied         | PASS               | denied
  4 | stranger reads 0 invitations                     | PASS               | 0
  5 | anon select invitations denied                   | PASS               | denied
  7 | wrong-email user cannot accept                   | PASS               | This invitation was sent to a different email address.
  8 | invitee joined with the INVITATION role          | PASS               | member
  9 | invitation consumed                              | PASS               | accepted
 10 | repeat accept is idempotent, one membership      | PASS               | already_accepted/1
 11 | owner can read and update own org invitation     | PASS               | 1
 12 | enable_hse_for_organization(other id) refused    | PASS               | refused
 99 | SUMMARY                                          | ALL 11 PROBES PASS | 11
(12 rows)

