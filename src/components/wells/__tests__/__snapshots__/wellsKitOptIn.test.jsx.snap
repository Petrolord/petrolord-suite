exports[`outside a scope the wells kit renders exactly as on main core photographs 1`] = `"<div class="space-y-3 text-xs" data-testid="wdm-core-panel"><div class="flex items-center gap-2 flex-wrap" data-testid="wdm-core-upload-form"><input type="file" accept="image/jpeg,image/png,image/webp" class="text-slate-400 text-xs" data-testid="wdm-core-file"><label class="flex items-center gap-1 text-slate-400">Top (m) <input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-core-top" value=""></label><label class="flex items-center gap-1 text-slate-400">Base (m) <input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 72px;" inputmode="decimal" data-testid="wdm-core-base" value=""></label><input class="bg-slate-950 border border-slate-700 rounded px-1 py-0.5 text-xs text-slate-100" style="width: 200px;" placeholder="Caption (optional)" data-testid="wdm-core-caption" value=""><button type="button" class="flex items-center gap-1 px-2 py-1 text-xs rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40" disabled="" data-testid="wdm-core-upload"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg> Add photo</button><span class="text-slate-500">JPEG, PNG or WebP up to 5 MB; 2.9 of 200 MB used on this well.</span></div><div class="flex gap-4 items-start"><div class="shrink-0 w-24" data-testid="wdm-core-strip" title="Depth-registered core strip"><div class="text-[10px] text-slate-500 mb-0.5">1500 m</div><div class="relative bg-slate-950 border border-slate-800 rounded" style="height: 320px;"><img src="https://