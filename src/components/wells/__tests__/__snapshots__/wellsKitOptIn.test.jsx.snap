exports[`outside a scope the wells kit renders exactly as on main layout panel, curve track open with every fill mode 1`] = `"<div class="p-2 space-y-1.5 text-xs border-t border-slate-800/60" data-testid="petro-layout"><div class="text-[10px] uppercase tracking-wider text-slate-500">Track layout</div><div class="flex items-center gap-1"><select class="rounded bg-slate-950 border border-slate-700 text-slate-200 px-1.5 py-0.5 text-xs w-full" data-testid="petro-layout-template"><option value="std-triple-combo">Standard triple combo (built-in)</option><option value="quicklook">Raw quicklook (built-in)</option><option value="lithology-quicklook">Lithology quicklook (built-in)</option><option value="tpl-x">Mine</option></select></div><div class="flex gap-1"><button type="button" data-testid="petro-layout-saveas" class="flex-1 px-1.5 py-0.5 rounded border border-cyan-700/60 text-cyan-300 hover:bg-cyan-500/10">Save as…</button><button type="button" data-testid="petro-layout-rename" title="Rename this template" class="flex-1 px-1.5 py-0.5 rounded border border-slate-700 text-slate-300 hover:bg-slate-800 disabled:opacity-40">Rename</button><button type="button" data-testid="petro-layout-delete" class="flex-1 px-1.5 py-0.5 rounded border border-red-900/60 text-red-300 hover:bg-red-500/10 disabled:opacity-40">Delete</button></div><div class="rounded border border-slate-800" data-testid="petro-layout-track-Porosity"><div class="flex items-center gap-1 px-1.5 py-1"><button type="button" class="text-slate-400" data-testid="petro-layout-expand-Porosity"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m6 9 6 6 6-6"></path></svg></button><span class="truncate text-slate-300">Porosity</span><span class="text-slate-600 text-[10px]">2 curves</span><div class="ml-auto flex items-center gap-0.5"><button type="button" title="Move up" 